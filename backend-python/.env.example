# ── Provedor de IA ────────────────────────────────────────
# Provedor usado quando o painel WordPress não manda um:
#   gemini | deepseek | openai | claude
LLM_PROVIDER=gemini
# As chaves são TODAS OPCIONAIS aqui desde a fase 0 do H1 (2026-09-04): elas
# podem chegar por requisição, vindas do painel WordPress. Preencha apenas a do
# provedor que este backend deve atender por conta própria. Se todas ficarem
# vazias e o painel não mandar chave, as rotas de IA respondem 401.
#
# ⚠️ NÃO acrescente aqui variável que não exista como campo em config.py: o
# pydantic-settings roda com extra='forbid' e o servidor RECUSA SUBIR com
# ValidationError. Foi o incidente de 2026-08-07 (LOG_LEVEL/ANONYMIZED_TELEMETRY).
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# ⚠️ É `CLAUDE_API_KEY`, e NÃO `ANTHROPIC_API_KEY`. O segundo nome é consumido
# pelo próprio SDK da Anthropic, e o main.py roda load_dotenv() — pôr aquele
# nome aqui criaria um degrau de autenticação invisível, fora da resolução do
# backend. Ver a nota do campo `claude_api_key` em config.py.
CLAUDE_API_KEY=

# ── Segurança ─────────────────────────────────────────────
# Token que o WordPress envia no header X-Api-Key
API_SECRET_TOKEN=gere-um-token-aleatorio-aqui

# ── ChromaDB — ajuste o caminho para o seu ambiente ───────
# Windows (desenvolvimento local):
#   CHROMA_DB_DIR=C:/caminho/para/chroma_db
# Linux / Cloud Run (produção):
#   CHROMA_DB_DIR=/data/chroma_db
CHROMA_DB_DIR=/caminho/para/chroma_db

# ── Opcional — modelo de cada provedor ─────────────────────
# LLM_MODEL é o modelo do GEMINI (nome sem sufixo por compatibilidade).
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_DEEPSEEK=deepseek-v4-flash
LLM_MODEL_OPENAI=gpt-5.6-luna
LLM_MODEL_CLAUDE=claude-sonnet-5

# ── Logging ────────────────────────────────────────────────
# Nível de log do backend (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── Telemetria ─────────────────────────────────────────────
# Desativa a telemetria anônima do ChromaDB
ANONYMIZED_TELEMETRY=False
