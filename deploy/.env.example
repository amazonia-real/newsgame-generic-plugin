# News Game — variáveis do servidor (copiar para .env, permissão 600, dono root).
# ⚠️ NUNCA versionar o .env nem colar chaves no repositório.
#
# ⚠️ O backend recusa subir se o .env DELE tiver campo desconhecido
# (pydantic-settings com extra='forbid'). Aqui o arquivo chega ao container
# como variáveis de ambiente, e variável sem campo correspondente é ignorada —
# mas não invente nomes: os válidos estão em backend-python/app/config.py.

# ── Domínio ──────────────────────────────────────────────
# Domínio ou subdomínio que aponta para esta máquina. O Caddy emite o HTTPS
# para ele. Sem domínio próprio, o sslip.io resolve um nome como
# 203-0-113-10.sslip.io para o IP escrito nele (provisório, só para ensaio).
NEWSGAME_DOMINIO=api.exemplo.com.br

# ── Acesso do plugin ao backend ──────────────────────────
# Chave que o WordPress envia no header X-Api-Key (no painel: "Token do
# Backend"). Gerar uma aleatória forte, por exemplo:  openssl rand -hex 32
API_SECRET_TOKEN=

# ── Provedores de IA ─────────────────────────────────────
# Todas OPCIONAIS: podem chegar por requisição, vindas do painel WordPress.
# Preencha só a do provedor que este backend deve atender por conta própria.
# ⚠️ É CLAUDE_API_KEY, e NÃO ANTHROPIC_API_KEY (ver config.py).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# ── Modelos (opcional; vazio = padrão do config.py) ──────
# LLM_MODEL=gemini-3.6-flash
# LLM_MODEL_DEEPSEEK=deepseek-v4-flash
# LLM_MODEL_OPENAI=gpt-5.6-luna
# LLM_MODEL_CLAUDE=claude-sonnet-5

# ── Logs e telemetria ────────────────────────────────────
LOG_LEVEL=INFO
ANONYMIZED_TELEMETRY=False

# CHROMA_DB_DIR é fixado pelo docker-compose.yml (/data/chroma_db, no volume
# "chroma") e não precisa ser definido aqui.
